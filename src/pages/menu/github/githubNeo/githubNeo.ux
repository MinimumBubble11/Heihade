<!--
  githubNeo —— 新版音效商店（GitHub 下载）
  数据源：GitHub 三仓库 catalog.json（三级回退）
  特性：分页 + 分类筛选 + 搜索（名称/描述/作者）+ 自研拼音输入法 + 下载队列
-->
<import name="input-method" src="../../../../components/InputMethod/InputMethod.ux"></import>
<import name="transferoverlay" src="../../../../components/TransferOverlay"></import>

<template>
  <stack class="root-stack">
    <!-- 滚动内容 -->
    <scroll id="mainScroll" class="page" scroll-y="true" bounces="true" onscroll="onScrollHandler">
      <!-- 标题行：标题 + 刷新 + 设置 -->
      <div class="title-row">
        <text class="title">音效下载</text>
        <div class="title-refresh" onclick="refreshCatalog">
          <image class="refresh-icon" src="/common/images/restart.png"></image>
        </div>
        <div class="title-refresh" onclick="openSettings">
          <image class="refresh-icon" src="/common/images/setting.png"></image>
        </div>
      </div>

      <!-- 搜索框（点击唤起自研输入法） -->
      <div class="search-row" id="searchRow">
        <div class="search-box" onclick="openKeyboard">
          <text class="search-text" if="{{ searchText }}">{{ searchText }}</text>
          <text class="search-placeholder" if="{{ !searchText }}">搜索音效（拼音/英文）</text>
        </div>
        <div class="search-clear" if="{{ !keyboardHide }}" onclick="closeKeyboard">
          <text class="search-clear-text">↓</text>
        </div>
        <div class="search-clear" elif="{{ searchText }}" onclick="clearSearch">
          <text class="search-clear-text">✕</text>
        </div>
      </div>

      <!-- 分类筛选：横向滚动（全部 + 各分类） -->
      <scroll class="cat-scroll" scroll-x="true" bounces="true">
        <div class="cat-row">
          <div class="cat-item {{ currentCat === '' ? 'active' : '' }}" onclick="selectCategory('')">
            <text class="cat-text">全部</text>
          </div>
          <div class="cat-item {{ currentCat === $item ? 'active' : '' }}" for="{{ categories }}" tid="cat" onclick="selectCategory($item)">
            <text class="cat-text">{{ $item }}</text>
          </div>
        </div>
      </scroll>

      <!-- 加载状态 -->
      <text if="{{ loading }}" class="loading-text">加载武器目录...</text>

      <!-- 加载失败 -->
      <div if="{{ loadError }}" class="error-box">
        <text class="error-title">加载失败</text>
        <text class="error-hint">{{ loadErrorText }}</text>
        <input class="retry-btn" type="button" value="重试" onclick="retryLoad" />
      </div>

      <!-- 音效列表：分页渲染（每页 20 个） -->
      <div class="weapon-list">
        <div class="weapon-item" for="{{ pageWeapons }}" tid="id" onclick="onWeaponTap($item)">
          <div class="weapon-info">
            <text class="weapon-name">{{ $item.name }}</text>
            <text class="weapon-meta">{{ $item.audioCount }} 个音频{{ $item.downloaded ? ' · 已下载' : '' }}{{ $item.playMode === 2 ? ' · Combo' : '' }}</text>
            <text class="weapon-desc" if="{{ $item.description }}">{{ $item.description }}</text>
            <text class="weapon-author" if="{{ $item.author }}">来源：{{ $item.author }}</text>
          </div>
          <text class="weapon-status">{{ $item.downloaded ? '√' : '↓' }}</text>
        </div>
      </div>

      <!-- 翻页栏 -->
      <div class="pager" if="{{ pageWeapons.length > 0 }}">
        <input class="page-btn" type="button" value="&lt;" onclick="prevPage" />
        <text class="page-num">{{ pageIndex + 1 }}/{{ totalPages }}</text>
        <input class="page-btn" type="button" value="&gt;" onclick="nextPage" />
      </div>

      <!-- 空状态：无武器 / 筛选无结果 -->
      <div if="{{ weapons.length === 0 && !loading && !loadError }}" class="empty-state">
        <text class="empty-title">暂无可用武器</text>
      </div>
      <div if="{{ weapons.length > 0 && filteredWeapons.length === 0 && !loading && !loadError }}" class="empty-state">
        <text class="empty-title">没有匹配的音效</text>
      </div>

      <div class="bottom-space"></div>
      <div class="kb-space" if="{{ !keyboardHide }}"></div>
    </scroll>

    <!-- 下载进度 + 待下载队列：浮层由 transferoverlay 组件承载，定位由本层负责 -->
    <div class="download-overlay">
      <transferoverlay source="download" @download-end="refreshDownloadState"></transferoverlay>
    </div>

    <!-- 固定返回按钮 -->
    <div class="back-wrapper">
      <input class="back-button-fixed" type="button" value="&lt; 返回" onclick="goBack" />
    </div>

    <!-- 自研输入法（底部悬浮，hide 控制显隐） -->
    <input-method
      hide="{{ keyboardHide }}"
      keyboardtype="QWERTY"
      maxlength="5"
      vibratemode="{{ vibrationMode }}"
      screentype="circle"
      @complete="onInputComplete"
      @delete="onInputDelete"
      @key-down="onInputKeyDown"
      @visibility-change="onInputVisibilityChange">
    </input-method>

    <!-- 设置面板（自绘，Vela 无原生对话框） -->
    <div if="{{ settingsVisible }}" class="settings-overlay">
      <div class="settings-dialog">
        <text class="settings-title">下载设置</text>
        <div class="settings-item" onclick="toggleShowDownloaded">
          <text class="settings-label">显示已下载音效</text>
          <image class="settings-switch" src="{{ showDownloaded ? '/common/images/true.png' : '/common/images/false.png' }}" />
        </div>
        <text class="settings-hint">关闭后列表不再显示已下载的音效</text>
        <input class="settings-btn" type="button" value="完成" onclick="closeSettings" />
      </div>
    </div>
  </stack>
</template>

<style>
.root-stack {
  width: 100%;
  height: 100%;
  position: relative;
  background-color: #000000;
}

.page {
  width: 100%;
  margin-top: 10px;
  min-height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

/* 圆屏：上下 10% + 左右 7-8% 安全区 */
@media (shape: circle) {
  .page { padding: 35px 10px; }
}

/* 方屏：小边距 */
@media (shape: rect) {
  .page { padding: 30px 0; }
}

.title-row {
  width: 100%;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-bottom: 6dp;
}

.title {
  font-size: 17dp;
  color: #4ccfff;
  font-weight: bold;
}

.title-refresh {
  width: 24px;
  height: 24px;
  border-radius: 13px;
  background-color: #333;
  justify-content: center;
  align-items: center;
  border: 2px solid #555;
  margin-left: 10px;
}

.refresh-icon {
  width: 15px;
  height: 15px;
  object-fit: contain;
}

/* 设置面板（自绘弹层） */
.settings-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.6);
}

.settings-dialog {
  width: 82%;
  flex-direction: column;
  align-items: center;
  padding: 14px 12px;
  background-color: #1a1a1a;
  border-radius: 14px;
  border: 2px solid #333333;
}

.settings-title {
  font-size: 15dp;
  color: #4ccfff;
  font-weight: bold;
  margin-bottom: 8dp;
}

.settings-item {
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8px 4px;
}

.settings-label {
  font-size: 14dp;
  color: #ffffff;
}

.settings-switch {
  width: 24dp;
  height: 24dp;
  object-fit: contain;
}

.settings-hint {
  width: 100%;
  font-size: 11dp;
  color: #888888;
  margin-top: 2dp;
  margin-bottom: 12dp;
}

.settings-btn {
  width: 70%;
  height: 32dp;
  border-radius: 16dp;
  background-color: #1d5c73;
  font-size: 14dp;
  color: #4ccfff;
}

@media (shape: circle) {
  .settings-dialog {
    width: 62%;
  }
}

/* 搜索框 */
.search-row {
  width: 92%;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-bottom: 4dp;
}

.search-box {
  flex: 1;
  height: 28dp;
  border-radius: 14dp;
  background-color: #222222;
  justify-content: center;
  align-items: center;
  border: 2px solid #555555;
}

.search-text {
  font-size: 14dp;
  color: #ffffff;
}

.search-placeholder {
  font-size: 12dp;
  color: #777777;
}

.search-clear {
  width: 28dp;
  height: 28dp;
  margin-left: 6dp;
  border-radius: 14dp;
  background-color: #333333;
  justify-content: center;
  align-items: center;
}

.search-clear-text {
  font-size: 14dp;
  color: #ff6b6b;
}

/* 分类筛选条 */
.cat-scroll {
  width: 92%;
  margin-top: 2dp;
  margin-bottom: 2dp;
}

.cat-row {
  flex-direction: row;
  align-items: center;
}

.cat-item {
  height: 26dp;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: 13dp;
  background-color: #222222;
  justify-content: center;
  align-items: center;
  margin-right: 6dp;
  border: 2px solid transparent;
}

.cat-item.active {
  border-color: #4ccfff;
  background-color: #2a2a2a;
}

.cat-text {
  font-size: 12dp;
  color: #cccccc;
}

.loading-text {
  font-size: 13dp;
  color: #888888;
  margin-top: 40dp;
}

.error-box {
  width: 90%;
  flex-direction: column;
  align-items: center;
  margin-top: 40dp;
}

.error-title {
  font-size: 16dp;
  color: #ffffff;
  font-weight: bold;
}

