<template>
  <stack class="root-stack">
    <!-- 滚动内容：添加 id 和 onscroll 事件 -->
    <scroll id="mainScroll" class="page" scroll-y="true" bounces="true" onscroll="onScrollHandler">
      <div class="btnbox">
        <!-- ★ 数据加载中：仅显示“加载中...”提示 -->
        <block if="{{ loading }}">
          <text class="loading-text">加载中...</text>
        </block>

        <!-- ★ 数据加载完成：才显示所有元素（音效管理/已下载/内置） -->
        <block if="{{ !loading }}">
          <!-- ★ 自定义音频同步入口 -->
          <div class="menu-actions">
            <input class="btn" type="button" value="音效管理" onclick="goCustomAudio" style="background-color: #1f3a2c;color: #87e9c6;" />
            <input class="btn" type="button" value="联网下载" onclick="goGithubDownload" />
          </div>

          <!-- ★ 已下载区（可收起/展开，点击播放，分页每页 5 个） -->
          <block if="{{ downloadedList.length > 0 }}">
            <div class="section-header" onclick="toggleDownloaded">
              <text class="section-title">已下载</text>
              <text class="section-arrow">{{ downloadedCollapsed ? '→' : '↓' }}</text>
            </div>
            <block if="{{ !downloadedCollapsed }}">
              <div class="menu-item" for="{{ downloadedPage }}" tid="id" onclick="onDownloadedClick($item)">
                <text class="menu-name">{{ $item.name }}</text>
                <text class="menu-arrow">›</text>
              </div>
              <div class="pager" if="{{ downloadedPage.length > 0 }}">
                <input class="page-btn" type="button" value="&lt;" onclick="prevDownloadedPage" />
                <text class="page-num">{{ downloadedPageIndex + 1 }}/{{ downloadedTotalPages }}</text>
                <input class="page-btn" type="button" value="&gt;" onclick="nextDownloadedPage" />
              </div>
            </block>
          </block>

          <!-- ★ 内置音效区（可收起/展开，分页每页 5 个） -->
          <div class="section-header" onclick="toggleBuiltin">
            <text class="section-title">内置音效</text>
            <text class="section-arrow">{{ builtinCollapsed ? '→' : '↓' }}</text>
          </div>
          <block if="{{ !builtinCollapsed }}">
            <div class="menu-item" for="{{ pageList }}" tid="key" onclick="onItemClick($item)">
              <text class="menu-name">{{ $item.name }}</text>
              <text class="menu-arrow">&gt</text>
            </div>
            <!-- ★ 分页栏 -->
            <div class="pager" if="{{ pageList.length > 0 }}">
              <input class="page-btn" type="button" value="&lt;" onclick="prevPage" />
              <text class="page-num">{{ pageIndex + 1 }}/{{ totalPages }}</text>
              <input class="page-btn" type="button" value="&gt;" onclick="nextPage" />
            </div>
          </block>
        </block>
      </div>
      <div class='btnbox'></div>
    </scroll>

    <!-- 固定返回按钮，居中 -->
    <div class="back-wrapper">
      <input class="back-button-fixed" type="button" value="&lt; 返回" onclick="goBack" />
    </div>
  </stack>
</template>

<style>
.root-stack {
  width: 100%;
  height: 100%;
  position: relative;
}

.page {
  width: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.btnbox {
  margin-top: 30px;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.btn {
  width: 75dp;
  height: 31dp;
  border-radius: 18%;
  background-color: #333333;
  font-size: 15dp;
  font-weight: bold;
  color: #82d1ff;
  text-align: center;
  margin: 4dp;
}

.menu-actions {
  width: 100%;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

/* 数据加载中的提示文本 */
.loading-text {
  width: 100%;
  text-align: center;
  font-size: 14dp;
  color: #888888;
  margin-top: 20dp;
}

/* 分区标题栏（已下载 / 内置音效，可点击收起/展开） */
.section-header {
  width: 92%;
  background-color: #222222;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 15%;
  margin-top: 10px;
  margin-bottom: 2px;
  padding: 4px 15px;
}

.section-title {
  font-size: 13dp;
  color: #888888;
  text-align: left;
}

.section-arrow {
  font-size: 12dp;
  color: #888888;
}

/* 平铺列表项（每行一个音效） */
.menu-item {
  width: 92%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 5px 10px;
  margin: 4px 0;
  background-color: #333333;
  border-radius: 12px;
}

.menu-name {
  font-size: 15dp;
  color: #82d1ff;
  font-weight: bold;
}

.menu-arrow {
  font-size: 14dp;
  color: #82d1ff;
}

/* 分页栏 */
.pager {
  width: 92%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
}
@media (shape:circle){
  .pager{
    width: 60%;
  }
}

.page-btn {
  width: 30px;
  height: 30px;
  border-radius: 100%;
  border: 2px solid #333333;
  background-color: #222222;
  font-size: 12dp;
  color: #4ccfff;
}

.page-num {
  font-size: 15px;
  color: #ffffff;
}

/* 固定返回按钮包装器（居中） */
.back-wrapper {
  background-color: #000000;
  position: absolute;
  width: 100%;
  height: 32dp;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.back-button-fixed {
  width: 53dp;
  height: 23dp;
  border-radius: 14dp;
  background-color: #222222;
  font-size: 12dp;
  color: #cccccc;
}

@media (shape: rect) {
  .btn {
    width: 84dp;
    height: 36dp;
    font-size: 15dp;
    margin: 4dp;
  }
}

@media (shape: circle) {
  .section-header{
    width: 80%;
    padding: 4px 8px;
  }

  .menu-item{
    width: 76%;
    padding: 6px 12px;
  }
}
</style>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import prompt from '@system.prompt'
import pages from '../../common/pages'
import audioSync from '../../common/audiosync'
import vibration from '../../common/vibrate'
import settings from '../../common/settings'

// 每页显示的音效数量
const PAGE_SIZE = 5

export default {
  private: {
    vibrationEnabled: true,
    vibrationMode: 'short',
    // ★ 自动获取的音效列表
    menuList: [],
    // ★ 分页渲染的当前页列表
    pageList: [],
    pageIndex: 0,
    totalPages: 1,
    // ★ 已下载音效（来自 audiosync 清单，独立分区展示）
    downloadedList: [],
    downloadedPage: [],
    downloadedPageIndex: 0,
    downloadedTotalPages: 1,
    // ★ 分区收起状态（true=收起，默认收起）
    downloadedCollapsed: true,
    builtinCollapsed: true,
    // ★ 数据加载状态（获取音效列表期间显示“加载中...”）
    loading: true
  },

  // ★ 自动获取音效列表（遍历 common/pages.js 唯一数据源，新增音效无需再改菜单）
  buildMenuList() {
    const list = []
    Object.keys(pages).forEach(function(key) {
      const cfg = pages[key]
      if (cfg && cfg.name) {
        list.push({ key: key, name: cfg.name })
      }
    })
    this.menuList = list
    this.updatePages()
  },

  // ===== 分页（每页 5 个音效） =====
  updatePages() {
    this.totalPages = Math.max(1, Math.ceil(this.menuList.length / PAGE_SIZE))
    if (this.pageIndex > this.totalPages - 1) this.pageIndex = this.totalPages - 1
    this.applyPage()
  },

  applyPage() {
    const start = this.pageIndex * PAGE_SIZE
    this.pageList = this.menuList.slice(start, start + PAGE_SIZE)
  },

  prevPage() {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    if (this.pageIndex <= 0) return
    this.pageIndex--
    this.applyPage()
    settings.set('menu_builtin_page', String(this.pageIndex))
    // 手动翻页完成后滚动到页面最底部
    this.scrollToBottom()
  },

  nextPage() {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    if (this.pageIndex >= this.totalPages - 1) return
    this.pageIndex++
    this.applyPage()
    settings.set('menu_builtin_page', String(this.pageIndex))
    // 手动翻页完成后滚动到页面最底部
    this.scrollToBottom()
  },

  // ===== 已下载音效（来自 audiosync，分页每页 5 个） =====
  loadDownloaded() {
    const that = this
    audioSync.load(function(list) {
      that.downloadedList = (list || []).map(function(s) {
        return { id: s.id, name: s.name }
      })
      that.downloadedUpdatePages()
      // ★ 内置列表与已下载均加载完成后，才关闭“加载中...”提示并显示所有元素
      that.loading = false
    })
  },

  // 恢复折叠状态与页码（应用不重启期间保持用户操作，首次进入默认收起；settings 内存缓存）
  loadMenuState() {
    const that = this
    settings.get('menu_downloaded_collapsed').then(function(data) {
      if (data !== undefined && data !== null && data !== '') {
        that.downloadedCollapsed = (data === 'true')
      }
    })
    settings.get('menu_builtin_collapsed').then(function(data) {
      if (data !== undefined && data !== null && data !== '') {
        that.builtinCollapsed = (data === 'true')
      }
    })
    settings.get('menu_downloaded_page').then(function(data) {
      if (data !== undefined && data !== null && data !== '') {
        that.downloadedPageIndex = parseInt(data, 10) || 0
        if (that.downloadedList.length > 0) that.downloadedUpdatePages()
      }
    })
    settings.get('menu_builtin_page').then(function(data) {
      if (data !== undefined && data !== null && data !== '') {
        that.pageIndex = parseInt(data, 10) || 0
        that.updatePages()
      }
    })
  },

  downloadedUpdatePages() {
    this.downloadedTotalPages = Math.max(1, Math.ceil(this.downloadedList.length / PAGE_SIZE))
    if (this.downloadedPageIndex > this.downloadedTotalPages - 1) this.downloadedPageIndex = this.downloadedTotalPages - 1
    this.downloadedApplyPage()
  },

  downloadedApplyPage() {
    const start = this.downloadedPageIndex * PAGE_SIZE
    this.downloadedPage = this.downloadedList.slice(start, start + PAGE_SIZE)
  },

  prevDownloadedPage() {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    if (this.downloadedPageIndex <= 0) return
    this.downloadedPageIndex--
    this.downloadedApplyPage()
    settings.set('menu_downloaded_page', String(this.downloadedPageIndex))
    // 手动翻页完成后滚动到页面最底部
    this.scrollToBottom()
  },

  nextDownloadedPage() {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    if (this.downloadedPageIndex >= this.downloadedTotalPages - 1) return
    this.downloadedPageIndex++
    this.downloadedApplyPage()
    settings.set('menu_downloaded_page', String(this.downloadedPageIndex))
    // 手动翻页完成后滚动到页面最底部
    this.scrollToBottom()
  },

  // 滚动到页面最底部（翻页渲染完成后执行；超大 top 值由框架钳制到最大滚动量）
  scrollToBottom() {
    const that = this
    this.$nextTick(() => {
      const scrollEl = that.$element('mainScroll')
      if (scrollEl) {
        scrollEl.scrollTo({ top: 999999, behavior: 'instant' })
      }
    })
  },

  // 点击已下载音效：进入统一播放页（custom 模式）
  onDownloadedClick(item) {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    const targetUri = '/pages/play?custom=' + item.id
    settings.set('lastTargetPage', targetUri)
    router.replace({ uri: targetUri, params: { ___PARAM_LAUNCH_FLAG___: 'clearTask' } })
  },

  // 已下载区：收起/展开（状态持久化，应用不重启期间保持）
  toggleDownloaded() {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    this.downloadedCollapsed = !this.downloadedCollapsed
    settings.set('menu_downloaded_collapsed', String(this.downloadedCollapsed))
  },

  // 内置音效区：收起/展开（状态持久化，应用不重启期间保持）
  toggleBuiltin() {
    if (this.vibrationEnabled) vibrator.vibrate({ mode: this.vibrationMode })
    this.builtinCollapsed = !this.builtinCollapsed
    settings.set('menu_builtin_collapsed', String(this.builtinCollapsed))
  },

  // ★ 每次显示时刷新已下载区（从下载/自定义页返回时保证最新）
  onShow() {
    this.loadDownloaded()
  },

  // ★ 页面就绪时自动获取音效并恢复滚动位置
  onReady() {
    const that = this
    this.loadVibration()
    this.loadMenuState()
    this.buildMenuList()
    this.loadDownloaded()
    settings.get('scroll_position').then(function(data) {
      if (data) {
        that.$nextTick(() => {
          const scrollEl = that.$element('mainScroll')
          if (scrollEl) {
            scrollEl.scrollTo({
              top: parseInt(data, 10),
              behavior: 'instant'
            })
          }
        })
      }
    })
  },

  // ★ 滚动时存储当前位置（节流写入：300ms 合并一次，降低高频 storage 写）
  onScrollHandler(e) {
    settings.setThrottled('scroll_position', e.scrollY, 300)
  },

  // ★ 加载震动设置（复用设置页可配置的震动模式）
  loadVibration() {
    vibration.loadSetting().then((vib) => {
      this.vibrationEnabled = vib.enabled
      this.vibrationMode = vib.mode
    })
  },

  // 返回按钮（带震动）
  goBack() {
    if (this.vibrationEnabled) {
      vibrator.vibrate({ mode: this.vibrationMode })
    }
    // 加载中禁止返回
    if (this.loading) {
      prompt.showToast({ message: '正在加载，请稍候', duration: 1000 })
      return
    }
    router.replace({ uri: '/pages/start/loading' })
  },

  // 系统返回键拦截
  onBackPress() {
    // 加载中禁止返回
    if (this.loading) {
      prompt.showToast({ message: '正在加载，请稍候', duration: 1000 })
      return true
    }
    router.replace({ uri: '/pages/start/loading' })
    return true
  },

  // 公共重置方法（原逻辑）
  resetSharedState() {
    settings.set('play_count', '0')
    settings.set('is_locked', 'false')
    settings.set('fixed_play_count', '0')
    settings.set('group_locked', 'false')
    settings.set('locked_group', '1')
    settings.set('group_inner_index', '0')
  },

  // ★ 通用跳转方法（统一播放页，替代所有单独页面） ★
  onItemClick(item) {
    this.resetSharedState()
    // 独立页面：CS 炸弹、遥遥领先，其余音效仍走统一播放页
    const standalonePages = { CSboom: '/pages/play/CSboom', Yaoyaolingxian: '/pages/play/Yaoyaolingxian' }
    const targetUri = standalonePages[item.key] || ('/pages/play?name=' + item.key)
    settings.set('lastTargetPage', targetUri)
    router.replace({ uri: targetUri, params: { ___PARAM_LAUNCH_FLAG___: 'clearTask' } })
  },

  // ★ 自定义音频同步入口 ★
  goCustomAudio() {
    if (this.vibrationEnabled) {
      vibrator.vibrate({ mode: this.vibrationMode })
    }
    router.replace({ uri: '/pages/menu/custom' })
  },

  // 在线下载入口：通过 loading.ux 中央路由，由开关决定跳转新版/旧版商店
  goGithubDownload() {
    vibration.vibrate(this.vibrationMode)
    router.push({ uri: '/pages/start/loading', params: { target: 'download' } })
  }
}
</script>