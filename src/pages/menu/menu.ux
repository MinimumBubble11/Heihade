<style>
.root-stack {
  width: 100%;
  height: 100%;
  position: relative;
}

.page {
  width: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.btnbox {
  margin-top: 30px;
  width: 100%;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
}

.btn {
  width: 75dp;
  height: 31dp;
  border-radius: 18%;
  background-color: #333333;
  font-size: 15dp;
  font-weight: bold;
  color: #82d1ff;
  text-align: center;
  margin: 4dp;
}

/* 固定返回按钮包装器（居中） */
.back-wrapper {
  background-color: #000000;
  position: absolute;
  width: 100%;
  height: 32dp;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.back-button-fixed {
  width: 53dp;
  height: 23dp;
  border-radius: 14dp;
  background-color: #222222;
  font-size: 12dp;
  color: #cccccc;
}

@media (shape: rect) {
  .btn {
    width: 84dp;
    height: 36dp;
    font-size: 15dp;
    margin: 4dp;
  }
}
</style>

<script>
import router from '@system.router'
import storage from '@system.storage'
import vibrator from '@system.vibrator'

export default {
  private: {
    vibrationEnabled: true
  },

  // ★ 页面就绪时恢复滚动位置
  onReady() {
    const that = this
    storage.get({
      key: 'scroll_position',
      success: function(data) {
        if (data) {
          that.$nextTick(() => {
            const scrollEl = that.$element('mainScroll')
            if (scrollEl) {
              scrollEl.scrollTo({
                top: parseInt(data, 10),
                behavior: 'instant'
              })
            }
          })
        }
      },
      fail: function() {
        // 忽略
      }
    })
  },

  // ★ 滚动时存储当前位置
  onScrollHandler(e) {
    storage.set({
      key: 'scroll_position',
      value: String(e.scrollY)
    })
  },

  // 返回按钮（带震动）
  goBack() {
    if (this.vibrationEnabled) {
      vibrator.vibrate({ mode: 'short' })
    }
    router.replace({ uri: '/pages/start/loading' })
  },

  // 系统返回键拦截
  onBackPress() {
    router.replace({ uri: '/pages/start/loading' })
    return true
  },

  // 公共重置方法（原逻辑）
  resetSharedState() {
    storage.set({ key: 'play_count', value: '0' })
    storage.set({ key: 'is_locked', value: 'false' })
    storage.set({ key: 'fixed_play_count', value: '0' })
    storage.set({ key: 'group_locked', value: 'false' })
    storage.set({ key: 'locked_group', value: '1' })
    storage.set({ key: 'group_inner_index', value: '0' })
  },

  // ★ 通用跳转方法（替代所有单独的方法）
  gotoPage(pageName) {
    this.resetSharedState()
    const targetUri = '/pages/' + pageName
    storage.set({ key: 'lastTargetPage', value: targetUri })
    router.replace({ uri: targetUri })
  }
}
</script>